{
  "buildCommand": "cd voltix && npm ci && npm run build",
  "outputDirectory": "voltix/dist",
  "framework": "vite",
  "installCommand": "cd voltix && npm ci",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "env": {
    "VITE_API_URL": "https://voltix-production-ecd8.up.railway.app"
  }
}
